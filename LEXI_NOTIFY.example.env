# Copy this file to LEXI_NOTIFY.env in the same folder (LEXI_NOTIFY.env is gitignored).
# Buddy handles must match how each contact appears for iMessage on Steve’s Mac
# (often +15551234567 in E.164, or an Apple ID email).
#
#   cp LEXI_NOTIFY.example.env LEXI_NOTIFY.env
#   nano LEXI_NOTIFY.env
#
# One recipient (Lexi only):
#   export LEXI_IMESSAGE_HANDLE="+1REPLACE_WITH_LEXIS_NUMBER"
#
# Same notifications to several people (space-separated — everyone gets identical texts).
# If you set PRICING_NOTIFY_HANDLES, it is used instead of LEXI_IMESSAGE_HANDLE.
#   export PRICING_NOTIFY_HANDLES="+1LEXI_NUMBER +1YOUR_NUMBER"
#
export LEXI_IMESSAGE_HANDLE="+1REPLACE_WITH_LEXIS_NUMBER"

# Optional: seconds the BoardsToPrice folder must be unchanged before a run starts.
# export PRICE_INBOX_QUIET_SEC=120
# export PRICE_INBOX_POLL_SEC=10
